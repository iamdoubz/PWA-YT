# Copy to .env before `docker compose up`.

# Host port the app (nginx + built PWA) is published on.
APP_PORT=8080

# Comma-separated allowed origins for the server's CORS policy, or "*".
# Set this to the real origin (e.g. the cloudflared tunnel hostname) once you
# have one — "*" is fine only while everything stays on localhost.
PWA_YT_ORIGINS=*

# WebAuthn relying-party ID — must match the hostname passkeys are registered
# against. "localhost" only works for local testing.
PWA_YT_RP_ID=localhost

# Fernet key encrypting stored cookies. Leave blank for a session-only key
# (regenerated, and every cookie decrypt fails, on every restart) or set it
# explicitly for a real deployment — server/main.py logs one on first boot.
PWA_YT_COOKIE_KEY=

# Set to 1 to expose /docs, /redoc, /openapi.json. Leave unset in production.
PWA_YT_ENABLE_DOCS=
