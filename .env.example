# Copy to .env before `docker compose up`.

# Host port the app (nginx + built PWA) is published on.
APP_PORT=8080

# Image tag for both containers. "latest" tracks main; pin a release (e.g.
# 0.9.0) for a deployment you want to stay put.
PWA_YT_TAG=latest

# Public origin this app is reached at, no trailing slash (e.g.
# https://music.example.com). Makes the Open Graph link-preview URLs absolute,
# which Facebook and X require; Slack/iMessage/Discord resolve relative ones
# fine. Leave blank and the tags stay relative — a supported configuration,
# not a broken one.
#
# Under Docker this is applied when the app container starts, so it works on a
# pulled image and needs no rebuild — change it and `docker compose up -d`.
# Outside Docker (`npm run dev`, `npm run build`) the same variable is read by
# Vite at build time from this file. Nothing else in here reaches the browser:
# only this one key is read, by exact name.
PUBLIC_ORIGIN=

# Comma-separated allowed origins for the server's CORS policy, or "*".
# Set this to the real origin (e.g. the cloudflared tunnel hostname) once you
# have one — "*" is fine only while everything stays on localhost.
PWA_YT_ORIGINS=*

# WebAuthn relying-party ID — must match the hostname passkeys are registered
# against. "localhost" only works for local testing.
PWA_YT_RP_ID=localhost

# Fernet key encrypting stored cookies. Leave blank for a session-only key
# (regenerated, and every cookie decrypt fails, on every restart) or set it
# explicitly for a real deployment — server/main.py logs one on first boot.
PWA_YT_COOKIE_KEY=

# Set to 1 to expose /docs, /redoc, /openapi.json. Leave unset in production.
PWA_YT_ENABLE_DOCS=

# SMTP relay for magic-link sign-in emails (D-008/D-028). Leave PWA_YT_SMTP_HOST
# blank to skip sending — the link is printed to the server log instead, which
# is fine for local testing.
PWA_YT_SMTP_HOST=
PWA_YT_SMTP_PORT=587
PWA_YT_SMTP_USER=
PWA_YT_SMTP_PASS=
PWA_YT_SMTP_FROM=noreply@pwa-yt.local
